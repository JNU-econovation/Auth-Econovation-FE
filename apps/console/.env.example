# console(어드민/개발자 콘솔) 앱 환경변수 예시. 실제 값은 .env에 작성하세요(.env는 git에서 무시됨).
# 프로덕션(Vercel)에서는 각 변수를 프로젝트 환경변수로 등록하세요.

# axios baseURL. 어드민 API 주소.
# 부팅 시 필수 — 누락되면 src/env.ts가 즉시 throw합니다.
VITE_API_URL=http://localhost:8081

# "true"면 MSW 목 서버를 구동해 백엔드 없이 화면을 시연(개발 전용).
# 프로덕션에서는 미설정 또는 false.
VITE_ENABLE_MSW=false

# 미인증 시 "로그인" 버튼이 이동할 SSO 로그인 페이지 주소.
# 콘솔은 자체 로그인 폼 없이 이 주소로 리다이렉트만 합니다(v2 명세 §6-1).
# 부팅 시 필수 — 누락되면 src/env.ts가 즉시 throw합니다. SSO 연동 확정 시 실제 값으로 교체.
VITE_SSO_LOGIN_URL=https://dev.eeos.econovation.kr/login
