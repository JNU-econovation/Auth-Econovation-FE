# web 앱 환경변수 예시. 실제 값은 .env에 작성하세요(.env는 git에서 무시됨).

# axios baseURL. 백엔드 API 주소.
VITE_API_URL=http://localhost:8081

# "true"면 MSW 목 서버를 구동해 백엔드 없이 화면을 시연(개발 전용).
VITE_ENABLE_MSW=false

# --- 개발 편의: '/' 진입 시 누락된 로그인 쿼리를 자동으로 채우는 기본값 ---
# 운영에서는 외부 서비스가 이 값들을 쿼리로 전달하므로 사용되지 않습니다(dev 모드 전용).
# 로그인 body의 clientId로 전송할 개발용 OAuth client-id.
VITE_DEV_CLIENT_ID=a1b2c3d4-1234-5678-9abc-def012345678
# 로그인 클라이언트 타입(web | app). 미설정 시 web.
VITE_DEV_CLIENT_TYPE=web
